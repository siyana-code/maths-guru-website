---
import Base from '../../../../layouts/Base.astro';
import Practice from '../../../../components/Practice.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('lesson', 'g6-3-2-worked');
if (!entry) throw new Error('Lesson g6-3-2-worked not found');

const { Content } = await render(entry);
---

<Base title="Same amount, different numbers" description={entry.data.description}>
  <p class="muted">
    <a href="/grade/6">Grade 6</a> &rsaquo; NIE competency 3.2 &rsaquo;
    Equivalent fractions
  </p>

  <Content />

  <hr />

  <h2>Practise this</h2>
  <p class="lede">
    There is no timer and no marks. Take your time. If you get something wrong,
    we will tell you exactly what went wrong.
  </p>

  <Practice competencyId="3.2" stage="independent" />
</Base>
