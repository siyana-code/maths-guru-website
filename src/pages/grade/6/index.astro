---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { QUESTION_BANKS, MISSING_QUESTION_BANKS } from '../../../data/questions';

/**
 * Grade lives on the competency, not the lesson. A lesson belongs to exactly one
 * competency, so deriving grade from the competency keeps the two from ever
 * disagreeing - which is the kind of drift that quietly breaks a syllabus-driven
 * site.
 */
const competencies = await getCollection('competency', (c) => c.data.grade === 6);
const grade6Ids = new Set(competencies.map((c) => c.data.id));

const lessons = await getCollection('lesson', (l) =>
  grade6Ids.has(l.data.competencyId),
);

const termOf = (id: string) =>
  competencies.find((c) => c.data.id === id)?.data.term ?? 1;

const hasPractice = (id: string) => Boolean(QUESTION_BANKS[id]);

// Planned topics from the official NIE sequence (research/03-grade6-syllabus.md).
// Listed explicitly rather than generated, so we are not claiming coverage we
// do not have.
const planned = [
  { id: '1.6', title: 'Factors and multiples up to 100', term: 2 },
  { id: '3.1', title: 'Unit and proper fractions', term: 2 },
  { id: '3.3', title: 'Comparing fractions', term: 2 },
  { id: '4.1', title: 'Ratio and rate', term: 3 },
];

const ready = planned.filter((p) => hasPractice(p.id));
const notReady = planned.filter((p) => !hasPractice(p.id));
---

<Base
  title="Grade 6 Mathematics"
  description="Grade 6 mathematics lessons following the NIE syllabus. Free, explained step by step, works on a phone."
>
  <h1>Grade 6 Mathematics</h1>
  <p class="lede">
    Grade 6 is the first year of secondary school, and the year the maths
    foundations are laid. We follow the NIE syllabus order, so everything here
    lines up with what your teacher is teaching.
  </p>

  <div class="callout">
    <p class="callout-title">Why there are only two lessons</p>
    <p>
      Grade 6 is 25 lessons and 157 periods. We are building them slowly on
      purpose. A lesson that explains <em>why</em> each step works takes much
      longer to write than one that just shows the steps, and the whole value
      of this site is the explaining.
    </p>
    <p>
      We would rather have two topics done properly than twenty done thinly.
    </p>
  </div>

  <h2>Lessons</h2>

  {
    lessons.map((lesson) => (
      <div class="card">
        <h3>{lesson.data.title}</h3>
        <div class="card-meta">
          <span class="tag">Competency {lesson.data.competencyId}</span>
          <span class="tag">{lesson.data.minutes} min</span>
          <span class="tag">Term {termOf(lesson.data.competencyId)}</span>
        </div>
        <p>{lesson.data.description}</p>
        <div class="button-row">
          <a class="button" href={`/grade/6/${lesson.data.competencyId}`}>
            Read the lesson
          </a>
          <a
            class="button button-quiet"
            href={`/grade/6/${lesson.data.competencyId}/practice`}
          >
            Practise
          </a>
        </div>
      </div>
    ))
  }

  <h2>Planned, not ready yet</h2>

  <p class="muted">
    These follow the official NIE sequence. We are listing them so you can see
    where this is going, not so you can click through to an empty page.
  </p>

  {
    ready.map((p) => (
      <div class="card">
        <h3>{p.title}</h3>
        <div class="card-meta">
          <span class="tag">Competency {p.id}</span>
          <span class="tag">Term {p.term}</span>
        </div>
        <p class="muted">Questions built. The lesson is still being written.</p>
      </div>
    ))
  }

  {
    notReady.map((p) => (
      <div class="card card-dim">
        <h3>{p.title}</h3>
        <div class="card-meta">
          <span class="tag">Competency {p.id}</span>
          <span class="tag">Term {p.term}</span>
          <span class="tag">Planned</span>
        </div>
      </div>
    ))
  }

  <h2>What comes after this</h2>

  <p class="muted">
    Grade 7 and Grade 8 follow the same pattern. Grade 11 (O-Level) is a much
    larger job &mdash; 25 units and 190 periods &mdash; and you can read about
    it <a href="/grade/11">here</a>.
  </p>
</Base>

<style>
  .card-dim {
    opacity: 0.6;
    background: var(--wash);
  }
</style>
