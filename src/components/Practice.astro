---
/**
 * The practice runner.
 *
 * Generic across competencies: pass a competencyId and it loads the right bank
 * from the registry. Adding a competency's questions means adding one entry to
 * src/data/questions/index.ts, nothing else.
 *
 * Design rules encoded here, all from research/08-teaching-method.md:
 * - Never say "Incorrect". Every wrong answer resolves to a named misconception.
 * - Accept mathematically-equivalent forms. Marking 4/6 wrong where 2/3 is
 *   expected is the emphatic error correction Ashcraft (2002) identifies as a
 *   documented cause of maths anxiety.
 * - Hints forfeit mastery, because asking for help means you have not got it
 *   yet. That is what makes the mastery number honest.
 * - Errors are framed as information, never as failure.
 */

import type { Question } from '../lib/types';
import { independentFor, bankFor } from '../data/questions';

interface Props {
  competencyId: string;
  /** Restrict to one ladder stage. Defaults to independent, which is what mastery measures. */
  stage?: Question['stage'];
  /** Heading shown above the question. */
  title?: string;
  /** Rendered inside a <pre>, for printing. */
  compact?: boolean;
}

const { competencyId, stage = 'independent', title } = Astro.props;

const all = bankFor(competencyId);
const pool = stage ? all.filter((q) => q.stage === stage) : all;

const serialise = (q: Question) => ({
  id: q.id,
  competencyId: q.competencyId,
  prompt: q.prompt,
  math: q.math ?? null,
  accept: q.accept,
  explain: q.explain,
  hints: q.hints ?? [],
  stage: q.stage,
  completionStart: q.completionStart ?? null,
  diagnoses: q.diagnoses.map((d) => ({
    when: d.when,
    say: d.say,
    because: d.because,
    instead: d.instead,
  })),
});

const payload = pool.map(serialise);
const independentCount = independentFor(competencyId).length;
---

<section
  class="practice-zone"
  data-competency={competencyId}
  data-stage={stage}
>
  {
    pool.length === 0 ? (
      <div class="callout">
        <p class="callout-title">Practice for this topic is not ready yet</p>
        <p>
          The lesson is written, but we have not built the questions yet. We would
          rather say so than put loose questions here that do not explain why an
          answer is wrong.
        </p>
      </div>
    ) : (
      <>
        <h2>{title ?? 'Practise this'}</h2>
        <p class="muted">
          {
            stage === 'independent'
              ? `${independentCount} question${independentCount === 1 ? '' : 's'}, no timer. Get something wrong and we will explain exactly what happened, why, and what to try instead.`
              : 'We start this one for you.'
          }
        </p>

        <div class="progress-line">
          <span id="progress-text">Loading your progress...</span>
          <span id="streak-text" class="muted"></span>
        </div>

        <div
          class="progress-track"
          role="progressbar"
          aria-labelledby="progress-text"
        >
          <div class="progress-fill" id="progress-fill" style="width: 0%"></div>
        </div>

        <p class="muted" id="why-this-question"></p>

        <div class="practice" id="question-card">
          <p class="practice-stage" id="stage-label"></p>
          <p id="question-prompt"></p>
          <p id="question-math"></p>

          <div id="completion-start" hidden>
            <div class="callout callout-key">
              <p class="callout-title">We have started this for you</p>
              <p id="completion-text"></p>
            </div>
          </div>

          <label class="muted" for="answer">Your answer</label>
          <input
            class="field"
            id="answer"
            type="text"
            inputmode="text"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="Type your answer, for example 2/3"
            aria-describedby="feedback"
          />

          <div class="button-row">
            <button class="button" id="check" type="button">
              Check my answer
            </button>
            <button class="hint-btn" id="hint" type="button" hidden>
              Give me a hint
            </button>
          </div>

          <div class="hint-list" id="hints" hidden></div>

          <div
            class="feedback"
            id="feedback"
            role="status"
            aria-live="polite"
          >
          </div>

          <div class="button-row" id="next-row" hidden>
            <button class="button" id="next" type="button">
              Next question
            </button>
          </div>
        </div>

        <p class="muted" id="summary" hidden></p>
      </>
    )
  }
</section>

{
  pool.length > 0 && (
    <script
      type="application/json"
      id="question-data"
      set:html={JSON.stringify(payload)}
      is:inline
    />
  )
}

{pool.length > 0 && <script src="../scripts/practice.ts" />}

<style>
  .practice-zone {
    margin-block: 1.5rem;
  }
</style>
